{
  "name": "patriarchs-altar-functions",
  "version": "2.0.0",
  "description": "Cloud Functions for The Patriarchs' Altar: Stripe Checkout + purchase webhook",
  "main": "index.js",
  "private": true,
  "engines": {
    "node": "22"
  },
  "scripts": {
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "serve": "firebase emulators:start --only functions,firestore",
    "shell": "firebase functions:shell"
  },
  "dependencies": {
    "firebase-admin": "^14.4.0",
    "firebase-functions": "^7.4.0",
    "stripe": "^22.6.2"
  }
}
