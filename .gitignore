*-firebase-adminsdk-*.json
serviceAccount*.json

# Cloud Functions dependencies and secrets
functions/node_modules/
functions/.env
functions/.env.*
node_modules/

# Environment files anywhere in the tree
.env
.env.local
.env.*.local

# Python bytecode from the helper scripts
__pycache__/
*.pyc

# Editor and OS noise
.DS_Store
*.swp
*.swo
*~
